(ns myapp\core
  (:require phel\html :as html))

(defn html [x]
  (println
   (html/html (html/doctype :html5) x)))

(defn page [x]
  (html
   (list
    [:head
     [:link {:rel "stylesheet" :href "/out/output.css"}]]
    [:body x])))

(defn main []
  (page
   [:div
    [:div {:class "bg-red-500 text-white"} "Clojure running on a free host!"]
    [:div "For details see " [:a.text-blue-500 {:href "https://github.com/whamtet/phel-hello-world"} "the Hello World"]]
    [:div "NHH!"]]))

(main)
