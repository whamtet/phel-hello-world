(ns myapp\core
    (:require phel\html :as html))

(defn html [x]
  (println
   (html/html (html/doctype :html5) x)))

(defn page [x]
  (html
   (list
    [:head
     [:link {:rel "stylesheet" :href "/out/output.css"}]]
    [:body x])))

(defn main []
  (page
   [:div {:class "m-2"}
    [:div "Clojure running on a free host!"]
    [:div "For details see "
     [:a {:class "text-blue-500"
          :href "https://github.com/whamtet/phel-hello-world"}
      "the Hello World"]]
    [:div "NHH!"]]))

(main)
